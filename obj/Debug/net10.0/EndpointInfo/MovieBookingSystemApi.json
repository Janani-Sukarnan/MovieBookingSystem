{
  "openapi": "3.1.1",
  "info": {
    "title": "MovieBookingSystemApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7182"
    },
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
